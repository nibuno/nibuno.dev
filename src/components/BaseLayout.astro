---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tatsuya Nibuno / nibu",
  description =
    "Tatsuya Nibuno（nibu）の個人サイト。個人開発、発表や文章、異業種からエンジニアになるまでの経歴をまとめています。",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Tatsuya Nibuno / nibu" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <slot />

    <footer class="site-footer" id="footer">
      <nav class="footer-links" aria-label="外部リンク">
        <a href="https://github.com/nibuno" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://nibutan.hatenablog.com/" target="_blank" rel="noreferrer">Blog</a>
        <a href="https://scrapbox.io/nibu/" target="_blank" rel="noreferrer">Cosense</a>
        <a href="https://www.docswell.com/user/nibuno" target="_blank" rel="noreferrer">Docswell</a>
        <a href="https://x.com/YumihikiDev" target="_blank" rel="noreferrer">X</a>
      </nav>
    </footer>

    <button class="to-top" type="button" aria-label="TOPへ戻る">
      <span aria-hidden="true">↑</span>
    </button>

    <script>
      const toTop = document.querySelector<HTMLButtonElement>(".to-top");

      if (toTop) {
        const update = () => {
          const past = window.scrollY >= window.innerHeight * 0.8;
          toTop.classList.toggle("is-visible", past);
        };

        update();
        window.addEventListener("load", update);
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update, { passive: true });
        toTop.addEventListener("click", () => window.scrollTo({ top: 0 }));
      }
    </script>
  </body>
</html>
