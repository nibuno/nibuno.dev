<button
  class="intro-avatar-switch"
  type="button"
  aria-pressed="false"
  aria-label="nibuのアイコン。押すと本人の写真に入れ替わります"
>
  <img
    class="intro-avatar intro-avatar--chicken"
    src="/images/nibu-chicken.jpg"
    alt=""
    width="400"
    height="400"
  />
  <img
    class="intro-avatar intro-avatar--profile"
    src="/images/nibu-avatar.jpg"
    alt=""
    width="256"
    height="256"
  />
</button>

<script>
  const swap = document.querySelector<HTMLButtonElement>(".intro-avatar-switch");

  if (swap) {
    swap.addEventListener("click", () => {
      const swapped = swap.classList.toggle("is-swapped");
      swap.setAttribute("aria-pressed", String(swapped));
    });
  }
</script>
