---
import BaseLayout from "../components/BaseLayout.astro";
import ProfileAvatar from "../components/ProfileAvatar.astro";
import { projects } from "../data/projects";

const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout>
  <main id="main">
    <section class="intro" id="top" aria-labelledby="intro-title">
      <div class="intro-content">
        <div class="intro-identity">
          <h1 id="intro-title">
            Tatsuya Nibuno <span class="intro-alias">/ nibu</span>
          </h1>
          <ProfileAvatar />
        </div>

        <div class="intro-copy">
          <p>
            Pythonを軸にWebアプリケーション開発をしています。<br />
            個人では、日々使う小さなツールを作ったり、学んだことをブログに書いたり、発表したりしています。
          </p>
        </div>
      </div>

      <a class="intro-link" href="#projects">個人開発を見る ↓</a>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">個人開発</h2>
      </div>

      <ol class="project-list">
        {
          featuredProjects.map((project) => (
            <li class="project">
              <h3>
                <a class="project-title-link" href={`/projects/${project.slug}/`}>
                  {project.title}
                </a>
              </h3>
              <p class="project-description">{project.summary}</p>
              <div class="project-links">
                <a class="project-link" href={`/projects/${project.slug}/`}>
                  詳しく見る →
                </a>
                {project.links.filter((link) => link.showOnHome).map((link) => (
                  <a
                    class="project-link"
                    href={link.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {link.label} ↗
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ol>

      <p class="section-links">
        <a href="/projects/">個人開発をすべて見る →</a>
      </p>
    </section>

    <section class="section" id="writing" aria-labelledby="writing-heading">
      <div class="section-heading">
        <h2 id="writing-heading">発表と文章</h2>
      </div>

      <ul class="links-list">
        <li>
          <a
            class="profile-link"
            href="https://www.docswell.com/s/nibuno/KMQYNG-2026-08-02-062049"
            target="_blank"
            rel="noreferrer"
          >
            <span class="link-meta">2026.08 · 発表</span>
            <span class="link-description">迷いながらも歩んできた — 異業種からエンジニアへ転職した後の試行錯誤</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            class="profile-link"
            href="https://nibutan.hatenablog.com/entry/2026/08/09/125843"
            target="_blank"
            rel="noreferrer"
          >
            <span class="link-meta">2026.08 · 記事</span>
            <span class="link-description">Matzの影響を受けてAOTコンパイラをPythonで作ってみたよ</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            class="profile-link"
            href="https://www.docswell.com/s/nibuno/ZX26L4-2026-06-21-115036"
            target="_blank"
            rel="noreferrer"
          >
            <span class="link-meta">2026.06 · 発表</span>
            <span class="link-description">Pythonで「俺」を表現する — Python + WebAssembly + Canvasでクリエイティブコーディング</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            class="profile-link"
            href="https://docswell.com/s/nibuno/5Q8J7W-2024-01-14-145124"
            target="_blank"
            rel="noreferrer"
          >
            <span class="link-meta">2023.10 · 発表</span>
            <span class="link-description">Djangoを仕事で使っていくために学んだこと</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>

      <nav class="section-links" aria-label="文章と発表資料の一覧">
        <a href="https://nibutan.hatenablog.com/" target="_blank" rel="noreferrer">ブログを読む ↗</a>
        <a href="https://www.docswell.com/user/nibuno" target="_blank" rel="noreferrer">発表資料をすべて見る ↗</a>
      </nav>
    </section>

    <section class="section" id="career" aria-labelledby="career-heading">
      <div class="section-heading">
        <h2 id="career-heading">経歴</h2>
      </div>

      <ol class="career-list career-list--summary">
        <li class="career-entry">
          <p class="career-period"><time datetime="2023-08">2023年8月〜</time></p>
          <div>
            <h3>株式会社ビープラウド</h3>
            <p>
              バックエンドを中心にWebアプリケーションを開発しています。<br>
              単に開発するだけでなく、顧客との仕様調整なども行います。<br>
              ふりかえり会の発案・進行や新入社員のメンターなども経験しています。
            </p>
          </div>
        </li>
        <li class="career-entry">
          <p class="career-period"><time datetime="2020-02">2020年2月〜</time></p>
          <div>
            <h3>エンジニア派遣会社</h3>
            <p>
              エンジニアとして働き始めました。<br>
              基幹システムの保守・運用・開発を経験しました。<br>
              自社のチームリーダーも経験しました。
            </p>
          </div>
        </li>
        <li class="career-entry">
          <p class="career-period">2015年4月〜</p>
          <div>
            <h3>専門商社</h3>
            <p>
              新卒入社した専門商社で販促支援業務を中心に携わりました。<br>
              当時はエンジニアではなく、社内ポータルサイトを作り直したきっかけから、エンジニアという生き方を志すようになりました。
            </p>
          </div>
        </li>
      </ol>

      <p class="section-links">
        <a href="/resume/">詳しく見る →</a>
      </p>
    </section>
  </main>
</BaseLayout>
