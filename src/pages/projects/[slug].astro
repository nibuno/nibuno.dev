---
import BaseLayout from "../../components/BaseLayout.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import { hasProjectsIndex, projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const title = `${project.title} — Tatsuya Nibuno / nibu`;
const shortTitle = project.shortTitle ?? project.title;

// 読み終えたあとの主動線。ほかの外部リンクは冒頭にあるので、ここでは繰り返さない
const primaryLink = project.links.find((link) => link.primary);

// 一覧を出していないあいだは、実際にたどってきたトップのセクションへ返す
const backHref = hasProjectsIndex ? "/projects/" : "/#projects";
const backLabel = hasProjectsIndex ? "ほかのつくったものを見る" : "サイトのTOPへ";
---

<BaseLayout title={title} description={project.summary}>
  <main class="detail-main" id="main">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">TOP</a>
      <span aria-hidden="true">/</span>
      {
        hasProjectsIndex && (
          <>
            <a href="/projects/">つくったもの</a>
            <span aria-hidden="true">/</span>
          </>
        )
      }
      <span aria-current="page">{shortTitle}</span>
    </nav>

    <article class="detail-article">
      <header class="detail-header">
        <h1>{project.title}</h1>
        <p class="detail-lead">{project.summary}</p>
        {
          project.links.length > 0 && (
            <nav class="detail-links" aria-label={`${project.title}の外部リンク`}>
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">
                  {link.label} ↗
                </a>
              ))}
            </nav>
          )
        }
      </header>

      {
        project.gallery ? (
          <ProjectGallery screenshots={project.gallery} />
        ) : project.screenshot && (
          <ProjectImage screenshot={project.screenshot} />
        )
      }

      {
        project.stack && (
          <dl class="detail-stack">
            <dt>技術</dt>
            <dd>{project.stack}</dd>
          </dl>
        )
      }

      {
        project.why && (
          <section class="detail-section">
            <h2>なぜつくったか</h2>
            {project.why.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        )
      }

      {
        project.sections.map((section) => (
          <section class="detail-section">
            <h2>{section.heading}</h2>
            {section.screenshot && (
              <ProjectImage screenshot={section.screenshot} inSection />
            )}
            {section.paragraphs?.map((paragraph) => (
              <p>{typeof paragraph === "string" ? paragraph : paragraph.map((part) =>
                typeof part === "string" ? part : <a href={part.href} target="_blank" rel="noreferrer">{part.label}</a>
              )}</p>
            ))}
          </section>
        ))
      }
    </article>

    <nav class="detail-end-nav" aria-label="このページのあとの行き先">
      {
        primaryLink && (
          <p class="detail-end-primary">
            <a href={primaryLink.href} target="_blank" rel="noreferrer">
              {shortTitle}を{primaryLink.label} ↗
            </a>
          </p>
        )
      }

      <p class="detail-end-support">
        <a href={backHref}>← {backLabel}</a>
      </p>
    </nav>
  </main>
  <dialog class="image-zoom-dialog" aria-label="拡大した画像">
    <button type="button" class="image-zoom-close" aria-label="画像を閉じる" autofocus>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <div class="image-zoom-frame">
    <img class="image-zoom-full" alt="" />
    <button type="button" class="image-zoom-arrow image-zoom-prev" aria-label="前の画像" hidden>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
    </button>
    <button type="button" class="image-zoom-arrow image-zoom-next" aria-label="次の画像" hidden>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
    </button>
    </div>
    <span class="gallery-announcement" aria-live="polite" aria-atomic="true" data-zoom-status></span>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>(".image-zoom-dialog");
    const fullImage = dialog?.querySelector<HTMLImageElement>(".image-zoom-full");
    const closeButton = dialog?.querySelector<HTMLButtonElement>(".image-zoom-close");
    let trigger: HTMLButtonElement | null = null;
    let previousOverflow = "";
    const previousButton = dialog?.querySelector<HTMLButtonElement>(".image-zoom-prev");
    const nextButton = dialog?.querySelector<HTMLButtonElement>(".image-zoom-next");
    const status = dialog?.querySelector<HTMLElement>("[data-zoom-status]");
    let images: HTMLButtonElement[] = [];
    let selected = 0;

    if (dialog && fullImage) {
      const showImage = (index: number) => {
        selected = (index + images.length) % images.length;
        const image = images[selected];
        const thumbnail = image.querySelector("img");
        const ratio = thumbnail ? thumbnail.width / thumbnail.height : 1;
        dialog.style.setProperty("--image-ratio", String(ratio));
        fullImage.src = image.dataset.src ?? "";
        fullImage.alt = image.dataset.alt ?? "";
        if (status) status.textContent = `${selected + 1} / ${images.length}：${fullImage.alt}`;
      };
      previousButton?.addEventListener("click", () => showImage(selected - 1));
      nextButton?.addEventListener("click", () => showImage(selected + 1));
      dialog.addEventListener("keydown", (event) => {
        if (images.length > 1 && (event.key === "ArrowLeft" || event.key === "ArrowRight")) {
          event.preventDefault();
          showImage(selected + (event.key === "ArrowLeft" ? -1 : 1));
        }
      });
      document.querySelectorAll<HTMLButtonElement>("[data-image-zoom]").forEach((button) => {
        button.addEventListener("click", () => {
          trigger = button;
          const gallery = button.closest("[data-project-gallery]");
          images = gallery ? Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-image-zoom]")) : [button];
          if (previousButton) previousButton.hidden = images.length < 2;
          if (nextButton) nextButton.hidden = images.length < 2;
          showImage(images.indexOf(button));
          previousOverflow = document.body.style.overflow;
          document.body.style.overflow = "hidden";
          dialog.showModal();
        });
      });
      closeButton?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        document.body.style.overflow = previousOverflow;
        trigger?.focus({ preventScroll: true });
      });
    }
  </script>
</BaseLayout>
