---
import BaseLayout from "../../components/BaseLayout.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const title = `${project.title} — Tatsuya Nibuno / nibu`;
---

<BaseLayout title={title} description={project.summary}>
  <main class="detail-main" id="main">
    <a class="back-link" href="/projects/">← 個人開発の一覧へ</a>

    <article class="detail-article">
      <header class="detail-header">
        <h1>{project.title}</h1>
        <p class="detail-lead">{project.summary}</p>
        {
          project.links.length > 0 && (
            <nav class="detail-links" aria-label={`${project.title}の外部リンク`}>
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">
                  {link.label} ↗
                </a>
              ))}
            </nav>
          )
        }
      </header>

      <dl class="detail-facts">
        {
          project.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        project.sections.map((section) => (
          <section class="detail-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))
      }
    </article>

    <nav class="detail-end-nav" aria-label="個人開発のページ">
      <a href="/projects/">個人開発の一覧へ戻る →</a>
    </nav>
  </main>
</BaseLayout>
