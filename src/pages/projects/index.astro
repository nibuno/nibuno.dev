---
import BaseLayout from "../../components/BaseLayout.astro";
import { projects } from "../../data/projects";

const title = "個人開発 — Tatsuya Nibuno / nibu";
const description =
  "Tatsuya Nibuno（nibu）がこれまでにつくったWebアプリケーション、ツール、個人サイトの一覧です。";
---

<BaseLayout title={title} description={description}>
  <main class="detail-main projects-index-main" id="main">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">TOP</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">個人開発</span>
    </nav>

    <header class="projects-index-header">
      <h1>個人開発</h1>
    </header>

    <ol class="project-list projects-index-list">
      {
        projects.map((project) => (
          <li class="project">
            {project.status && <p class="project-meta">{project.status}</p>}
            <h2>
              <a class="project-title-link" href={`/projects/${project.slug}/`}>
                {project.title}
              </a>
            </h2>
            <p class="project-description">{project.summary}</p>
            <p class="project-links">
              <a class="project-link" href={`/projects/${project.slug}/`}>
                詳しく見る →
              </a>
            </p>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
